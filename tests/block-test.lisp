(in-package #:tui-markdown/tests)

(defun pm (&rest lines) (md:parse-markdown (apply #'nl lines)))

(deftest parse-headings
  (ok (equal '((:heading 1 ("a"))) (pm "# a")))
  (ok (equal '((:heading 6 ("six"))) (pm "###### six")))
  (ok (equal '((:paragraph ("####### seven"))) (pm "####### seven")) "more than six is text")
  (ok (equal '((:paragraph ("#5 bolt"))) (pm "#5 bolt")) "the space is required")
  (ok (equal '((:heading 2 ("closed"))) (pm "## closed ##")) "closing sequence dropped")
  (ok (equal '((:heading 2 ("a#"))) (pm "## a#")) "no space before #: kept")
  (ok (equal '((:heading 1 ())) (pm "#")) "empty heading")
  (ok (equal '((:heading 2 ("x"))) (pm "   ## x")) "up to three spaces of indent")
  (ok (equal '((:heading 1 ((:emph ("a")) " b"))) (pm "# *a* b")) "inline content")
  (ok (equal '((:paragraph ("p")) (:heading 1 ("h")) (:paragraph ("q")))
             (pm "p" "# h" "q"))
      "a heading interrupts a paragraph and needs no blank lines"))

(deftest parse-paragraphs-and-breaks
  (ok (equal '((:paragraph ("a" (:soft-break) "b")) (:paragraph ("c")))
             (pm "a" "   b" "" "" "c"))
      "continuation indent stripped; blank lines separate")
  (ok (equal '((:paragraph ("a" (:hard-break) "b"))) (pm "a  " "b")) "two trailing spaces")
  (ok (equal '((:paragraph ("a" (:hard-break) "b"))) (pm "a\\" "b")) "backslash newline")
  (ok (equal '((:paragraph ("a"))) (pm "a   ")) "trailing spaces of the last line dropped")
  (ok (equal '((:paragraph ("a" (:soft-break) "# not"))) (pm "a" "    # not"))
      "indented four: a paragraph continuation, never a block start")
  (ok (equal '((:paragraph ("x"))) (md:parse-markdown (format nil "x~C~C" #\Return #\Newline)))
      "CRLF")
  (ok (null (md:parse-markdown "")))
  (ok (null (pm "" "   ")))
  (ok (signals (md:parse-markdown 42) 'type-error)))

(deftest parse-thematic-breaks
  (ok (equal '((:thematic-break)) (pm "***")))
  (ok (equal '((:thematic-break)) (pm " - - -")))
  (ok (equal '((:thematic-break)) (pm "_____")))
  (ok (equal '((:paragraph ("--"))) (pm "--")))
  (ok (equal '((:paragraph ("a")) (:thematic-break) (:paragraph ("b"))) (pm "a" "---" "b"))
      "no setext headings: --- after a paragraph is a break"))

(deftest parse-fenced-code
  (ok (equal '((:code-block "lisp" ("(+ 1 2)" "" "x"))) (pm "```lisp" "(+ 1 2)" "" "x" "```")))
  (ok (equal '((:code-block nil ("a"))) (pm "~~~" "a" "~~~")))
  (ok (equal '((:code-block "py" ("a"))) (pm "``` py extra words" "a" "```")) "language = first word")
  (ok (equal '((:code-block nil ("a" "```"))) (pm "````" "a" "```" "````"))
      "a shorter fence does not close")
  (ok (equal '((:code-block nil ("a" "b"))) (pm "```" "a" "b")) "unclosed: to the end")
  (ok (equal '((:code-block nil ("a" " b" "c"))) (pm "  ```" "  a" "   b" "c" "  ```"))
      "the opening fence's indent is removed from content lines")
  (ok (equal '((:paragraph ((:code "a") "b"))) (pm "``` a ```b")) "backticks in a backtick info: not a fence")
  (ok (equal '((:paragraph ("p")) (:code-block nil ("x")) (:paragraph ("q")))
             (pm "p" "```" "x" "```" "q"))
      "a fence interrupts a paragraph")
  (ok (equal (list (list :code-block "go" (list "    x")))
             (md:parse-markdown (format nil "```go~%~Cx~%```~%" #\Tab)))
      "leading tabs become spaces (4-column stops)"))

(deftest parse-block-quotes
  (ok (equal '((:block-quote ((:paragraph ("a" (:soft-break) "b"))))) (pm "> a" ">b")))
  (ok (equal '((:block-quote ((:paragraph ("a")) (:block-quote ((:paragraph ("b")))))))
             (pm "> a" ">" "> > b")))
  (ok (equal '((:block-quote ((:bullet-list t (((:paragraph ("x"))) ((:paragraph ("y"))))))))
             (pm "> - x" "> - y")))
  (ok (equal '((:block-quote ((:paragraph ("a")))) (:paragraph ("b"))) (pm "> a" "b"))
      "no lazy continuation"))

(deftest parse-bullet-lists
  (ok (equal '((:bullet-list t (((:paragraph ("a"))) ((:paragraph ("b"))))))
             (pm "- a" "- b")))
  (ok (equal '((:bullet-list nil (((:paragraph ("a"))) ((:paragraph ("b"))))))
             (pm "- a" "" "- b"))
      "a blank line between items: loose")
  (ok (equal '((:bullet-list nil (((:paragraph ("a")) (:paragraph ("b"))))))
             (pm "- a" "" "  b"))
      "two blocks in an item with a blank between: loose")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))
                                 (:bullet-list t (((:paragraph ("b"))) ((:paragraph ("c"))))))
                                ((:paragraph ("d"))))))
             (pm "- a" "  - b" "  - c" "- d"))
      "nested")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))))) (:bullet-list t (((:paragraph ("b"))))))
             (pm "- a" "* b"))
      "a new bullet character starts a new list")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))))) (:paragraph ("b")))
             (pm "- a" "b"))
      "no lazy continuation")
  (ok (equal '((:bullet-list t (((:paragraph ("a"))) ())))
             (pm "+ a" "+"))
      "an empty item")
  (ok (equal '((:bullet-list t (((:paragraph ("a")) (:code-block "sh" ("ls" "" "pwd"))))))
             (pm "- a" "  ```sh" "  ls" "" "  pwd" "  ```"))
      "a fence inside an item keeps its blank line")
  (ok (equal '((:paragraph ("p")) (:bullet-list t (((:paragraph ("x"))))))
             (pm "p" "- x"))
      "a bullet item interrupts a paragraph")
  (ok (equal '((:paragraph ("p" (:soft-break) "-")))
             (pm "p" "-"))
      "an empty item does not"))

(deftest parse-ordered-lists
  (ok (equal '((:ordered-list 1 #\. t (((:paragraph ("a"))) ((:paragraph ("b"))))))
             (pm "1. a" "2. b")))
  (ok (equal '((:ordered-list 7 #\) t (((:paragraph ("a"))) ((:paragraph ("b"))))))
             (pm "7) a" "3) b"))
      "the first number is the start; later numbers are ignored")
  (ok (equal '((:ordered-list 1 #\. t (((:paragraph ("a"))))) (:ordered-list 2 #\) t (((:paragraph ("b"))))))
             (pm "1. a" "2) b"))
      "a new delimiter starts a new list")
  (ok (equal '((:paragraph ("in" (:soft-break) "2024. it rained")))
             (pm "in" "2024. it rained"))
      "only a list starting at 1 interrupts a paragraph")
  (ok (equal '((:paragraph ("p")) (:ordered-list 1 #\. t (((:paragraph ("x"))))))
             (pm "p" "1. x")))
  (ok (equal '((:ordered-list 1 #\. t (((:paragraph ("a")) (:bullet-list t (((:paragraph ("b")))))))))
             (pm "1. a" "   - b"))
      "content column = marker width + following spaces")
  (ok (equal '((:paragraph ("1234567890. x"))) (pm "1234567890. x")) "at most nine digits"))

(deftest parse-tables
  (ok (equal '((:table (:left :center :right nil)
                (("a") ("b") ("c") ("d"))
                ((("1") ("2") ("3") ("4")))))
             (pm "| a | b | c | d |" "|:--|:-:|--:|---|" "| 1 | 2 | 3 | 4 |")))
  (ok (equal '((:table (nil nil) (("a") ("b")) ((("x") ()) (("1") ("2")))))
             (pm "a | b" "--|--" "x" "1 | 2 | 3"))
      "no outer pipes; rows padded / cut to the header's cell count")
  (ok (equal '((:table (nil) (("a|b")) ((((:code "x") " y")))))
             (pm "| a\\|b |" "| --- |" "| `x` y |"))
      "escaped pipe; inline content in cells")
  (ok (equal '((:table (nil nil) (("a") ("b")) ((("1") ("2")))) (:paragraph ("after")))
             (pm "|a|b|" "|-|-|" "|1|2|" "" "after"))
      "a blank line ends the table")
  (ok (equal '((:table (nil) (("a")) ((("1")))) (:heading 1 ("h")))
             (pm "|a|" "|-|" "|1|" "# h"))
      "a block start ends the table")
  (ok (equal '((:paragraph ("| a | b |" (:soft-break) "|---|"))) (pm "| a | b |" "|---|"))
      "cell counts must match")
  (ok (equal '((:paragraph ("p" (:soft-break) "| a |" (:soft-break) "| - |")))
             (pm "p" "| a |" "| - |"))
      "a table does not interrupt a paragraph"))
