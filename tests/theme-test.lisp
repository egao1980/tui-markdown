(in-package #:tui-markdown/tests)

(deftest theme-defaults
  (ok (equal '(:bold t :underline :single) (style-keys (md:theme-style :heading-1))))
  (ok (equal '(:bold t) (style-keys (md:theme-style :heading))))
  (ok (equal '(:italic t) (style-keys (md:theme-style :emph))))
  (ok (equal '(:strike t) (style-keys (md:theme-style :strike))))
  (ok (equal '(:fg 6) (style-keys (md:theme-style :code))))
  (ok (equal '(:fg 4 :underline :single) (style-keys (md:theme-style :link))))
  (ok (equal '(:faint t) (style-keys (md:theme-style :quote-bar))))
  (ok (equal '() (style-keys (md:theme-style :list-marker))))
  (ok (equal '(:fg 2) (style-keys (md:theme-style :diff-added))))
  (ok (equal '(:fg 1 :inverse t) (style-keys (md:theme-style :diff-removed-word))))
  (ok (equal '(:faint t) (style-keys (md:theme-style :diff-line-number))))
  (ok (every (lambda (role) (tp:style-p (md:default-theme-style role))) md:+theme-roles+)
      "every role has a default")
  (ok (= 22 (length md:+theme-roles+))))

(deftest theme-overrides
  (let ((theme (list :strong (tp:make-style :foreground 3))))
    (ok (equal '(:fg 3) (style-keys (md:theme-style :strong theme))) "the theme entry wins")
    (ok (equal '(:italic t) (style-keys (md:theme-style :emph theme))) "missing roles fall back"))
  (ok (signals (md:theme-style :nope) 'type-error))
  (ok (signals (md:default-theme-style :nope) 'type-error)))

(deftest overlay-style-rules
  (let* ((base (tp:make-style :foreground 1 :bold t))
         (over (tp:make-style :italic t :background 4 :hyperlink "u"))
         (s (md:overlay-style base over)))
    (ok (equal '(:fg 1 :bg 4 :bold t :italic t :link "u") (style-keys s)))
    (ok (equal '(:fg 1 :bold t) (style-keys base)) "BASE is not mutated")
    (ok (not (eq s base))))
  (ok (equal '(:fg 2 :bold t)
             (style-keys (md:overlay-style (tp:make-style :foreground 1 :bold t)
                                           (tp:make-style :foreground 2))))
      "a non-default colour replaces")
  (ok (equal '(:fg 1 :bold t)
             (style-keys (md:overlay-style (tp:make-style :foreground 1 :bold t) (tp:make-style))))
      "default attributes do not clear")
  (ok (signals (md:overlay-style nil (tp:make-style)) 'type-error)))

(deftest expand-tabs-stops
  (ok (equal '("a   b") (texts (list (md:expand-tabs (format nil "a~Cb" #\Tab))))))
  (ok (equal '("    x") (texts (list (md:expand-tabs (format nil "~Cx" #\Tab))))))
  (ok (equal '("abcd    e") (texts (list (md:expand-tabs (format nil "abcd~Ce" #\Tab))))))
  (ok (equal '("日  x") (texts (list (md:expand-tabs (format nil "日~Cx" #\Tab)))))
      "stops count cells: a wide char is 2")
  (ok (equal '("a b") (texts (list (md:expand-tabs (format nil "a~Cb" #\Tab) :tab-width 2)))))
  (let ((line (md:expand-tabs (list (w:text-run "a" :bold t)
                                    (w:text-run (format nil "~Cb" #\Tab) :italic t)))))
    (ok (equal '(("a" :bold t) ("   b" :italic t)) (segments line)) "the spaces keep the tab's style")))

(deftest break-runs-by-cells
  (flet ((br (x w) (texts (md:break-runs x w))))
    (ok (equal '("abcd" "ef") (br "abcdef" 4)))
    (ok (equal '("ab c" "d ef") (br "ab cd ef" 4)) "no word breaks, spaces kept")
    (ok (equal '("abc") (br "abc" 3)))
    (ok (equal '("") (br "" 3)))
    (ok (equal '("a" "" "b") (br (format nil "a~%~%b") 3)))
    (ok (equal '("a日" "本") (br "a日本" 3)) "a wide char that does not fit moves down")
    (ok (equal '("日" "本") (br "日本" 1)) "at least one character per line")
    (ok (equal (list (u "e" #x301 "x") "y") (br (u "e" #x301 "xy") 2)) "a combining mark stays with its base"))
  (let ((lines (md:break-runs (list (w:text-run "abc" :bold t) (w:text-run "def")) 4)))
    (ok (equal '(("abc" :bold t) ("d")) (segments (first lines))))
    (ok (equal '(("ef")) (segments (second lines)))))
  (ok (signals (md:break-runs "abc" 0) 'type-error)))
