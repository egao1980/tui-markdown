(in-package #:tui-markdown)

;;; ------------------------------------------------------------------
;;; Reading unified diff text (the READING rules in diff.lisp's header)
;;; into sections of meta lines and hunks.

(defstruct (dsection (:constructor make-dsection (file-p &optional old new)))
  file-p old new
  (items '())                           ; reversed: (:meta string) | dhunk
  (added 0) (removed 0))

(defstruct (dhunk (:constructor make-dhunk (old-start old-count new-start new-count)))
  old-start old-count new-start new-count
  (rows '()))                           ; reversed: drow

(defstruct (drow (:constructor make-drow (kind text old new)))
  kind text old new)                    ; kind :context :removed :added

(defun %diff-lines (text)
  "TEXT split at LF, no empty tail, one trailing CR dropped from each line."
  (let ((lines '()) (n (length text)) (start 0))
    (loop while (< start n)
          do (let* ((p (position #\Newline text :start start))
                    (end (or p n))
                    (e (if (and (> end start) (char= (char text (1- end)) #\Return))
                           (1- end)
                           end)))
               (push (subseq text start e) lines)
               (setf start (if p (1+ p) n))))
    (coerce (nreverse lines) 'simple-vector)))

(defun %prefix-p (prefix line)
  (and (>= (length line) (length prefix)) (string= prefix line :end2 (length prefix))))

(defun %header-path (s)
  "A ---/+++ path: text after a TAB dropped, /dev/null → NIL, one leading
component stripped."
  (let* ((p (subseq s 0 (or (position #\Tab s) (length s))))
         (p (string-right-trim " " p)))
    (cond ((string= p "/dev/null") nil)
          ((position #\/ p) (subseq p (1+ (position #\/ p))))
          (t p))))

(defun %parse-range (s i)
  "Parse \"a[,b]\" at I → (values a b end) or NIL."
  (let ((j i) (n (length s)))
    (loop while (and (< j n) (digit-char-p (char s j))) do (incf j))
    (when (= j i) (return-from %parse-range nil))
    (let ((a (parse-integer s :start i :end j)) (b 1))
      (when (and (< j n) (char= (char s j) #\,))
        (let ((k (1+ j)))
          (loop while (and (< k n) (digit-char-p (char s k))) do (incf k))
          (when (= k (1+ j)) (return-from %parse-range nil))
          (setf b (parse-integer s :start (1+ j) :end k) j k)))
      (values a b j))))

(defun %parse-hunk-header (line)
  "\"@@ -a[,b] +c[,d] @@…\" → (values a b c d), else NIL."
  (when (%prefix-p "@@ -" line)
    (multiple-value-bind (a b j) (%parse-range line 4)
      (when (and a (%prefix-p " +" (subseq line j)))
        (multiple-value-bind (c d k) (%parse-range line (+ j 2))
          (when (and c (%prefix-p " @@" (subseq line k)))
            (values a b c d)))))))

(defun %read-diff (text)
  "Unified diff TEXT → a list of DSECTIONs in order."
  (let* ((lines (%diff-lines text))
         (n (length lines))
         (sections '())
         (i 0))
    (labels ((current () (first sections))
             (new-section (file-p &optional old new)
               (push (make-dsection file-p old new) sections)
               (current))
             (section ()
               (or (current) (new-section nil)))
             (add-meta (line)
               (push (list :meta line) (dsection-items (section)))))
      (loop while (< i n)
            do (let ((line (svref lines i)))
                 (cond
                   ((%prefix-p "diff --git " line)
                    (let* ((rest (subseq line 11))
                           (b (search " b/" rest)))
                      (if (and b (%prefix-p "a/" rest))
                          (new-section t (subseq rest 2 b) (subseq rest (+ b 3)))
                          (new-section t rest rest)))
                    (incf i))
                   ((and (%prefix-p "--- " line) (< (1+ i) n)
                         (%prefix-p "+++ " (svref lines (1+ i))))
                    (let ((old (%header-path (subseq line 4)))
                          (new (%header-path (subseq (svref lines (1+ i)) 4)))
                          (s (current)))
                      (if (and s (dsection-file-p s)
                               (notany #'dhunk-p (dsection-items s)))
                          (setf (dsection-old s) old (dsection-new s) new)
                          (new-section t old new)))
                    (incf i 2))
                   ((%parse-hunk-header line)
                    (multiple-value-bind (a b c d) (%parse-hunk-header line)
                      (let ((s (section))
                            (h (make-dhunk a b c d))
                            (old a) (new c) (ob b) (nb d))
                        (incf i)
                        (loop while (and (< i n) (or (plusp ob) (plusp nb)))
                              do (let* ((l (svref lines i))
                                        (ch (if (plusp (length l)) (char l 0) #\Space))
                                        (body (if (plusp (length l)) (subseq l 1) "")))
                                   (case ch
                                     (#\Space (push (make-drow :context body old new) (dhunk-rows h))
                                      (incf old) (incf new) (decf ob) (decf nb))
                                     (#\- (push (make-drow :removed body old nil) (dhunk-rows h))
                                      (incf old) (decf ob) (incf (dsection-removed s)))
                                     (#\+ (push (make-drow :added body nil new) (dhunk-rows h))
                                      (incf new) (decf nb) (incf (dsection-added s)))
                                     (#\\)
                                     (t (return)))
                                   (incf i)))
                        (loop while (and (< i n) (%prefix-p "\\" (svref lines i))) do (incf i))
                        (push h (dsection-items s)))))
                   ((or (%prefix-p "index " line)
                        (%prefix-p "similarity index " line)
                        (%prefix-p "dissimilarity index " line))
                    (incf i))
                   ((%prefix-p "rename from " line)
                    (setf (dsection-old (section)) (subseq line 12))
                    (incf i))
                   ((%prefix-p "rename to " line)
                    (setf (dsection-new (section)) (subseq line 10))
                    (incf i))
                   (t (add-meta line) (incf i))))))
    (dolist (s sections)
      (setf (dsection-items s) (nreverse (dsection-items s)))
      (dolist (x (dsection-items s))
        (when (dhunk-p x) (setf (dhunk-rows x) (nreverse (dhunk-rows x))))))
    (nreverse sections)))
