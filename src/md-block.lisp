(in-package #:tui-markdown)

;;; ------------------------------------------------------------------
;;; Block parser (the BLOCKS rules in markdown.lisp's header). Lines are a
;;; simple-vector of strings; a container collects its lines with its
;;; marker / indentation stripped into a fresh vector and parses that.

(defvar *open-fence* nil
  "Set by the top-level parse to (char . length) when a fenced code block
runs unclosed to the end of the text; read by the stream's hidden-fence
rule.")

(defvar *depth* 0
  "Container nesting depth of the current %PARSE-BLOCKS call.")

(defun %expand-leading-tabs (line)
  "LINE with the tabs of its leading whitespace expanded to 4-column stops."
  (let ((end (or (position-if-not (lambda (ch) (member ch '(#\Space #\Tab))) line)
                 (length line))))
    (if (not (find #\Tab line :end end))
        line
        (with-output-to-string (out)
          (let ((col 0))
            (loop for i from 0 below end
                  for ch = (char line i)
                  do (if (char= ch #\Tab)
                         (let ((k (- 4 (mod col 4))))
                           (loop repeat k do (write-char #\Space out))
                           (incf col k))
                         (progn (write-char ch out) (incf col)))))
          (write-string line out :start end)))))

(defun %source-lines (string)
  "STRING → a simple-vector of lines: split at LF, one CR before it dropped,
no empty tail after a final LF, leading tabs expanded."
  (let ((lines '())
        (n (length string))
        (start 0))
    (loop while (< start n)
          do (let* ((p (position #\Newline string :start start))
                    (end (or p n))
                    (e (if (and p (> end start) (char= (char string (1- end)) #\Return))
                           (1- end)
                           end)))
               (push (%expand-leading-tabs (subseq string start e)) lines)
               (setf start (if p (1+ p) n))))
    (coerce (nreverse lines) 'simple-vector)))

;;; Line predicates

(defun %blank-p (line)
  (every (lambda (ch) (member ch '(#\Space #\Tab))) line))

(defun %indent (line)
  (or (position #\Space line :test-not #'char=) (length line)))

(defun %trim (s) (string-trim '(#\Space #\Tab) s))

(defun %thematic-break-p (line)
  (let ((ind (%indent line)))
    (and (<= ind 3)
         (< ind (length line))
         (let ((ch (char line ind)))
           (and (member ch '(#\* #\- #\_))
                (every (lambda (c) (or (char= c ch) (member c '(#\Space #\Tab))))
                       (subseq line ind))
                (>= (count ch line) 3))))))

(defun %atx-heading (line)
  "→ (values level content-string) for an ATX heading line, else NIL."
  (let ((ind (%indent line)))
    (when (<= ind 3)
      (let* ((n (length line))
             (k (%run-length line ind n #\#))
             (after (+ ind k)))
        (when (and (<= 1 k 6)
                   (or (= after n) (member (char line after) '(#\Space #\Tab))))
          (let* ((content (%trim (subseq line after)))
                 (end (length content))
                 (hash-start (or (position #\# content :test-not #'char= :from-end t
                                                       :end end)
                                 -1)))
            ;; closing run of # : the whole content, or preceded by a space
            (when (< (1+ hash-start) end)
              (cond ((= hash-start -1) (setf content ""))
                    ((member (char content hash-start) '(#\Space #\Tab))
                     (setf content (%trim (subseq content 0 (1+ hash-start)))))))
            (values k content)))))))

(defun %fence-start (line)
  "→ (values char length indent language) for an opening code fence."
  (let ((ind (%indent line)))
    (when (and (<= ind 3) (< ind (length line)))
      (let ((ch (char line ind)))
        (when (member ch '(#\` #\~))
          (let ((k (%run-length line ind (length line) ch)))
            (when (>= k 3)
              (let ((info (%trim (subseq line (+ ind k)))))
                (unless (and (char= ch #\`) (find #\` info))
                  (values ch k ind
                          (let ((w (subseq info 0 (position-if (lambda (c) (member c '(#\Space #\Tab)))
                                                               info))))
                            (if (zerop (length w)) nil w))))))))))))

(defun %fence-close-p (line ch len)
  (let ((ind (%indent line)))
    (and (<= ind 3)
         (< ind (length line))
         (let ((k (%run-length line ind (length line) ch)))
           (and (>= k len) (%blank-p (subseq line (+ ind k))))))))

(defun %quote-line-p (line)
  (let ((ind (%indent line)))
    (and (<= ind 3) (< ind (length line)) (char= (char line ind) #\>))))

(defun %strip-quote (line)
  (let* ((ind (%indent line))
         (j (1+ ind)))
    (when (and (< j (length line)) (char= (char line j) #\Space))
      (incf j))
    (subseq line j)))

(defun %list-item-start (line)
  "→ (values kind marker number content-column blank-rest-p) for a list item
line, else NIL. KIND :bullet (MARKER the char) or :ordered (MARKER the
delimiter)."
  (let ((ind (%indent line))
        (n (length line)))
    (when (and (<= ind 3) (< ind n))
      (let ((ch (char line ind))
            kind marker number mend)
        (cond ((member ch '(#\- #\+ #\*))
               (setf kind :bullet marker ch mend (1+ ind)))
              ((digit-char-p ch)
               (let ((j ind))
                 (loop while (and (< j n) (digit-char-p (char line j))) do (incf j))
                 (when (and (<= (- j ind) 9) (< j n) (member (char line j) '(#\. #\))))
                   (setf kind :ordered marker (char line j)
                         number (parse-integer line :start ind :end j)
                         mend (1+ j))))))
        (when (and kind (or (= mend n) (char= (char line mend) #\Space)))
          (let* ((s (%run-length line mend n #\Space))
                 (blank (= (+ mend s) n)))
            (values kind marker number
                    (cond (blank (1+ mend))
                          ((<= 1 s 4) (+ mend s))
                          (t (1+ mend)))
                    blank)))))))

(defun %interrupts-p (line)
  "True when LINE starts a block that interrupts a paragraph (or ends a
table)."
  (and (<= (%indent line) 3)
       (or (%atx-heading line)
           (%fence-start line)
           (%quote-line-p line)
           (%thematic-break-p line)
           (multiple-value-bind (kind marker number col blank) (%list-item-start line)
             (declare (ignore marker col))
             (and kind (not blank) (or (eq kind :bullet) (eql number 1)))))))

;;; Tables

(defun %split-cells (line)
  "LINE → its cell strings: trimmed, outer pipes dropped, split at unescaped
\"|\", \"\\|\" → \"|\", each trimmed."
  (let* ((s (%trim line))
         (start (if (and (plusp (length s)) (char= (char s 0) #\|)) 1 0))
         (end (length s)))
    (when (and (> end start) (char= (char s (1- end)) #\|)
               (not (and (>= (- end 2) start) (char= (char s (- end 2)) #\\))))
      (decf end))
    (let ((cells '())
          (cell (make-string-output-stream))
          (i start))
      (loop while (< i end)
            do (let ((ch (char s i)))
                 (cond ((and (char= ch #\\) (< (1+ i) end) (char= (char s (1+ i)) #\|))
                        (write-char #\| cell) (incf i 2))
                       ((char= ch #\|)
                        (push (%trim (get-output-stream-string cell)) cells) (incf i))
                       (t (write-char ch cell) (incf i)))))
      (push (%trim (get-output-stream-string cell)) cells)
      (nreverse cells))))

(defun %delimiter-row (line)
  "→ the alignments of a table delimiter row, else NIL."
  (when (and (<= (%indent line) 3) (find #\- line))
    (let ((cells (%split-cells line)))
      (when (every (lambda (c)
                     (let* ((a (if (and (plusp (length c)) (char= (char c 0) #\:)) 1 0))
                            (e (if (and (> (length c) a) (char= (char c (1- (length c))) #\:))
                                   (1- (length c))
                                   (length c))))
                       (and (< a e) (every (lambda (x) (char= x #\-)) (subseq c a e)))))
                   cells)
        (mapcar (lambda (c)
                  (let ((l (char= (char c 0) #\:))
                        (r (char= (char c (1- (length c))) #\:)))
                    (cond ((and l r) :center) (l :left) (r :right) (t nil))))
                cells)))))

(defun %table-row (line n)
  (let ((cells (mapcar #'%parse-inlines (%split-cells line))))
    (loop for i below n collect (nth i cells))))

;;; Blocks

(defun %subvector (lines start end)
  (subseq lines start end))

(defun %parse-blocks (lines &optional (start 0) (end (length lines)))
  "Parse LINES[START, END) → (values blocks gap-p); GAP-P is true when a
blank line separates two of these blocks."
  (let ((blocks '())
        (gap nil)
        (blank-pending nil)
        (i start))
    (flet ((add (b)
             (when (and blank-pending blocks) (setf gap t))
             (setf blank-pending nil)
             (push b blocks)))
      (loop while (< i end)
            do (let* ((line (svref lines i))
                      (ind (%indent line)))
                 (cond
                   ((%blank-p line)
                    (setf blank-pending t)
                    (incf i))
                   ((>= ind 4)
                    (multiple-value-bind (b next) (%parse-paragraph lines i end)
                      (add b) (setf i next)))
                   ((%thematic-break-p line)
                    (add (list :thematic-break))
                    (incf i))
                   ((%atx-heading line)
                    (multiple-value-bind (level content) (%atx-heading line)
                      (add (list :heading level (%parse-inlines content))))
                    (incf i))
                   ((%fence-start line)
                    (multiple-value-bind (b next) (%parse-fence lines i end)
                      (add b) (setf i next)))
                   ((%quote-line-p line)
                    (let ((j i))
                      (loop while (and (< j end) (%quote-line-p (svref lines j))) do (incf j))
                      (let ((inner (map 'simple-vector #'%strip-quote (%subvector lines i j))))
                        (add (list :block-quote (let ((*depth* (1+ *depth*)))
                                                  (values (%parse-blocks inner))))))
                      (setf i j)))
                   ((%list-item-start line)
                    (multiple-value-bind (b next) (%parse-list lines i end)
                      (add b) (setf i next)))
                   ((and (find #\| line) (< (1+ i) end)
                         (let ((aligns (%delimiter-row (svref lines (1+ i)))))
                           (and aligns (= (length aligns) (length (%split-cells line))))))
                    (multiple-value-bind (b next) (%parse-table lines i end)
                      (add b) (setf i next)))
                   (t
                    (multiple-value-bind (b next) (%parse-paragraph lines i end)
                      (add b) (setf i next)))))))
    (values (nreverse blocks) gap)))

(defun %parse-paragraph (lines i end)
  (let ((parts (list (string-left-trim '(#\Space #\Tab) (svref lines i))))
        (j (1+ i)))
    (loop while (and (< j end)
                     (let ((l (svref lines j)))
                       (not (or (%blank-p l) (%interrupts-p l)))))
          do (push (string-left-trim '(#\Space #\Tab) (svref lines j)) parts)
             (incf j))
    (let ((text (string-right-trim '(#\Space #\Tab)
                                   (format nil "~{~A~^~%~}" (nreverse parts)))))
      (values (list :paragraph (%parse-inlines text)) j))))

(defun %parse-fence (lines i end)
  (multiple-value-bind (ch len ind language) (%fence-start (svref lines i))
    (let ((content '())
          (j (1+ i))
          (closed nil))
      (loop while (< j end)
            do (let ((l (svref lines j)))
                 (when (%fence-close-p l ch len)
                   (setf closed t)
                   (incf j)
                   (return))
                 (push (subseq l (min (%indent l) ind (length l))) content)
                 (incf j)))
      (when (and (not closed) (zerop *depth*))
        (setf *open-fence* (cons ch len)))
      (values (list :code-block language (nreverse content)) j))))

(defun %parse-table (lines i end)
  (let* ((header-cells (%split-cells (svref lines i)))
         (n (length header-cells))
         (aligns (%delimiter-row (svref lines (1+ i))))
         (rows '())
         (j (+ i 2)))
    (loop while (and (< j end)
                     (let ((l (svref lines j)))
                       (not (or (%blank-p l) (%interrupts-p l)))))
          do (push (%table-row (svref lines j) n) rows)
             (incf j))
    (values (list :table aligns (mapcar #'%parse-inlines header-cells) (nreverse rows))
            j)))

(defun %same-list-p (kind marker line)
  (and (not (%thematic-break-p line))
       (multiple-value-bind (k m) (%list-item-start line)
         (and (eq k kind) (eql m marker)))))

(defun %parse-list (lines i end)
  (multiple-value-bind (kind marker number) (%list-item-start (svref lines i))
    (let ((items '())
          (loose nil)
          (j i))
      (loop
        (multiple-value-bind (k m num col blank) (%list-item-start (svref lines j))
          (declare (ignore k m num))
          (let ((item-lines (list (if blank "" (subseq (svref lines j) col))))
                (p (1+ j)))
            ;; the item's further lines
            (unless (and blank (or (>= p end) (%blank-p (svref lines p))))
              (loop while (< p end)
                    do (let ((l (svref lines p)))
                         (cond ((%blank-p l)
                                (let ((q (position-if-not #'%blank-p lines :start p :end end)))
                                  (if (and q (>= (%indent (svref lines q)) col))
                                      (progn (loop for r from p below q do (push "" item-lines))
                                             (setf p q))
                                      (return))))
                               ((>= (%indent l) col)
                                (push (subseq l col) item-lines)
                                (incf p))
                               (t (return))))))
            (multiple-value-bind (blocks gap)
                (let ((*depth* (1+ *depth*)))
                  (%parse-blocks (coerce (nreverse item-lines) 'simple-vector)))
              (when gap (setf loose t))
              (push blocks items))
            ;; the next item?
            (let ((q (or (position-if-not #'%blank-p lines :start p :end end) end)))
              (if (and (< q end) (%same-list-p kind marker (svref lines q)))
                  (progn (when (> q p) (setf loose t))
                         (setf j q))
                  (return (values
                           (if (eq kind :bullet)
                               (list :bullet-list (not loose) (nreverse items))
                               (list :ordered-list number marker (not loose) (nreverse items)))
                           p))))))))))
